<Window x:Class="Salli.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Salli"
        Width="430" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{DynamicResource TrackBrush}" CornerRadius="12">
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.3" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Seg" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Dot" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Width="24" Height="24" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.6"/>
                            <Ellipse Width="15" Height="15" Fill="{TemplateBinding Background}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="{DynamicResource CardSoftBrush}"/>
            <Setter Property="CornerRadius" Value="11"/>
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SubBrush}"/>
            <Setter Property="Margin" Value="6,14,0,6"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceSolidBrush}" CornerRadius="18"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="6,4,4,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Salli" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="  настройки" FontSize="16" Foreground="{DynamicResource SubBrush}"/>
                </StackPanel>
                <Button Style="{StaticResource Seg}" HorizontalAlignment="Right" Click="Close_Click"
                        Content="✕" ToolTip="Закрыть"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>

                    <TextBlock Text="ВНЕШНИЙ ВИД" Style="{StaticResource Section}"/>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <TextBlock Text="Тема" VerticalAlignment="Center" FontSize="12.5"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="DarkBtn" Style="{StaticResource Seg}" Content="Тёмная" Click="Theme_Click" Tag="dark"/>
                                <Button x:Name="LightBtn" Style="{StaticResource Seg}" Content="Светлая" Click="Theme_Click" Tag="light"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <TextBlock Text="Акцент" VerticalAlignment="Center" FontSize="12.5"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="AutoAccent" Style="{StaticResource Seg}" Content="Из обоев" Click="AccentAuto_Click"/>
                                <Button x:Name="BlueAccent" Style="{StaticResource Seg}" Content="●" Click="AccentColor_Click" Tag="#0A84FF"/>
                                <Button Style="{StaticResource Seg}" Content="●" Click="AccentColor_Click" Tag="#30D158"/>
                                <Button Style="{StaticResource Seg}" Content="●" Click="AccentColor_Click" Tag="#FF9F0A"/>
                                <Button Style="{StaticResource Seg}" Content="●" Click="AccentColor_Click" Tag="#FF375F"/>
                                <Button Style="{StaticResource Seg}" Content="●" Click="AccentColor_Click" Tag="#BF5AF2"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <TextBlock Text="Размер островка" VerticalAlignment="Center" FontSize="12.5"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="SizeCompact" Style="{StaticResource Seg}" Content="Мини" Click="Size_Click" Tag="compact"/>
                                <Button x:Name="SizeNormal"  Style="{StaticResource Seg}" Content="Обычный" Click="Size_Click" Tag="normal"/>
                                <Button x:Name="SizeLarge"   Style="{StaticResource Seg}" Content="Крупный" Click="Size_Click" Tag="large"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <TextBlock Text="Палитра" VerticalAlignment="Center" FontSize="12.5"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="PalGraphite" Style="{StaticResource Dot}" Tag="graphite"
                                        Background="#4A4A52" Click="Palette_Click" ToolTip="Graphite"/>
                                <Button x:Name="PalMidnight" Style="{StaticResource Dot}" Tag="midnight"
                                        Background="#3E6DB5" Click="Palette_Click" ToolTip="Midnight"/>
                                <Button x:Name="PalNord" Style="{StaticResource Dot}" Tag="nord"
                                        Background="#5E81AC" Click="Palette_Click" ToolTip="Nord"/>
                                <Button x:Name="PalMono" Style="{StaticResource Dot}" Tag="mono"
                                        Background="#9A9AA0" Click="Palette_Click" ToolTip="Mono"/>
                                <Button x:Name="PalSand" Style="{StaticResource Dot}" Tag="sand"
                                        Background="#B08968" Click="Palette_Click" ToolTip="Sand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Стекло" FontSize="12.5"/>
                                <TextBlock Text="полупрозрачная поверхность" FontSize="10.5"
                                           Foreground="{DynamicResource SubBrush}"/>
                            </StackPanel>
                            <ToggleButton x:Name="GlassSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="Glass_Changed" Unchecked="Glass_Changed"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <TextBlock Text="Язык" VerticalAlignment="Center" FontSize="12.5"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="LangRu" Style="{StaticResource Seg}" Content="Русский" Tag="ru"
                                        Click="Lang_Click"/>
                                <Button x:Name="LangEn" Style="{StaticResource Seg}" Content="English" Tag="en"
                                        Click="Lang_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="ПОВЕДЕНИЕ" Style="{StaticResource Section}"/>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Раскрывать при наведении" FontSize="12.5"/>
                                <TextBlock Text="без клика, через 0.4 сек" FontSize="10.5" Foreground="{DynamicResource SubBrush}"/>
                            </StackPanel>
                            <ToggleButton x:Name="HoverSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="Hover_Changed" Unchecked="Hover_Changed"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Тоньше при простое" FontSize="12.5"/>
                                <TextBlock Text="через 30 секунд без действий" FontSize="10.5" Foreground="{DynamicResource SubBrush}"/>
                            </StackPanel>
                            <ToggleButton x:Name="IdleSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="Idle_Changed" Unchecked="Idle_Changed"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Громкость колесом" FontSize="12.5"/>
                                <TextBlock Text="крутить мышь над островком" FontSize="10.5" Foreground="{DynamicResource SubBrush}"/>
                            </StackPanel>
                            <ToggleButton x:Name="WheelSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="Wheel_Changed" Unchecked="Wheel_Changed"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Свайп вниз — свернуть" FontSize="12.5"/>
                                <TextBlock Text="потянуть островок вниз мышью" FontSize="10.5" Foreground="{DynamicResource SubBrush}"/>
                            </StackPanel>
                            <ToggleButton x:Name="SwipeSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="Swipe_Changed" Unchecked="Swipe_Changed"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Звук открытия" FontSize="12.5"/>
                                <TextBlock Text="тихий «поп» при раскрытии" FontSize="10.5" Foreground="{DynamicResource SubBrush}"/>
                            </StackPanel>
                            <ToggleButton x:Name="SoundSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="Sound_Changed" Unchecked="Sound_Changed"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Режим стримера" FontSize="12.5"/>
                                <TextBlock Text="скрывает SSID и название трека" FontSize="10.5" Foreground="{DynamicResource SubBrush}"/>
                            </StackPanel>
                            <ToggleButton x:Name="StreamSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="Stream_Changed" Unchecked="Stream_Changed"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Скрывать в полном экране" FontSize="12.5"/>
                                <TextBlock Text="игры и видео — островок уезжает" FontSize="10.5"
                                           Foreground="{DynamicResource SubBrush}"/>
                            </StackPanel>
                            <ToggleButton x:Name="FsSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="Fs_Changed" Unchecked="Fs_Changed"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Горячие клавиши" FontSize="12.5"/>
                                <TextBlock Text="Ctrl+Alt+Space — поиск · Ctrl+Alt+M — mute" FontSize="10.5"
                                           Foreground="{DynamicResource SubBrush}"/>
                            </StackPanel>
                            <ToggleButton x:Name="HotkeySwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="Hotkey_Changed" Unchecked="Hotkey_Changed"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="ЧТО ПОКАЗЫВАТЬ" Style="{StaticResource Section}"/>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <TextBlock Text="Погода в баре" VerticalAlignment="Center" FontSize="12.5"/>
                            <ToggleButton x:Name="WeatherSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="Weather_Changed" Unchecked="Weather_Changed"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <TextBlock Text="Индикатор микрофона" VerticalAlignment="Center" FontSize="12.5"/>
                            <ToggleButton x:Name="MicSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="Mic_Changed" Unchecked="Mic_Changed"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <TextBlock Text="Скорость сети" VerticalAlignment="Center" FontSize="12.5"/>
                            <ToggleButton x:Name="NetSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="Net_Changed" Unchecked="Net_Changed"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <TextBlock Text="Эквалайзер" VerticalAlignment="Center" FontSize="12.5"/>
                            <ToggleButton x:Name="EqSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="Eq_Changed" Unchecked="Eq_Changed"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Визуализатор" FontSize="12.5"/>
                                <TextBlock Text="что рисует эквалайзер" FontSize="10.5"
                                           Foreground="{DynamicResource SubBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="VisOutput" Style="{StaticResource Seg}" Content="Звук" Tag="output"
                                        Click="Vis_Click"/>
                                <Button x:Name="VisMic" Style="{StaticResource Seg}" Content="Микрофон" Tag="mic"
                                        Click="Vis_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Картинки в буфере" FontSize="12.5"/>
                                <TextBlock Text="скриншоты сохраняются с превью" FontSize="10.5"
                                           Foreground="{DynamicResource SubBrush}"/>
                            </StackPanel>
                            <ToggleButton x:Name="ClipImgSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="ClipImg_Changed" Unchecked="ClipImg_Changed"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <TextBlock Text="Город для погоды" VerticalAlignment="Center" FontSize="12.5"/>
                            <TextBox x:Name="CityBox" Width="170" HorizontalAlignment="Right" FontSize="12"
                                     TextChanged="City_Changed"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="СИСТЕМА" Style="{StaticResource Section}"/>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <TextBlock Text="Автозапуск с Windows" VerticalAlignment="Center" FontSize="12.5"/>
                            <ToggleButton x:Name="AutoSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="Auto_Changed" Unchecked="Auto_Changed"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Ночной свет" FontSize="12.5"/>
                                <TextBlock Text="тёплый фильтр экрана" FontSize="10.5" Foreground="{DynamicResource SubBrush}"/>
                            </StackPanel>
                            <ToggleButton x:Name="NightSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Checked="Night_Changed" Unchecked="Night_Changed"/>
                        </Grid>
                    </Border>

                    <Button x:Name="ResetBtn" Style="{StaticResource Seg}" Content="Сбросить островок по центру"
                            Margin="0,10,0,4" Height="32" Click="Reset_Click"/>

                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Height="36" Margin="0,10,0,0" Cursor="Hand" Click="Close_Click"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentInkBrush}"
                    BorderThickness="0" FontSize="13" FontWeight="SemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="Готово"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
