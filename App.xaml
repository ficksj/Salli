<Application x:Class="Salli.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="SurfaceBrush"      Color="#FF141418"/>
        <SolidColorBrush x:Key="SurfaceSolidBrush" Color="#FF141418"/>
        <SolidColorBrush x:Key="CardBrush"         Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="CardSoftBrush"     Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="TrackBrush"        Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="TextBrush"         Color="#F5F5F7"/>
        <SolidColorBrush x:Key="SubBrush"          Color="#8E8E93"/>
        <SolidColorBrush x:Key="MutedBrush"        Color="#AEAEB2"/>
        <SolidColorBrush x:Key="ChipOnBrush"       Color="#F2F5F5F7"/>
        <SolidColorBrush x:Key="ChipOnInkBrush"    Color="#141418"/>
        <SolidColorBrush x:Key="ChipOnSubBrush"    Color="#4A4A4E"/>
        <SolidColorBrush x:Key="DividerBrush"      Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush"       Color="#FF0A84FF"/>
        <SolidColorBrush x:Key="AccentSoftBrush"   Color="#330A84FF"/>
        <SolidColorBrush x:Key="AccentInkBrush"    Color="#141418"/>
        <SolidColorBrush x:Key="GoodBrush"         Color="#FF30D158"/>
        <SolidColorBrush x:Key="WarnBrush"         Color="#FFFF9F0A"/>
        <SolidColorBrush x:Key="BadBrush"          Color="#FFFF453A"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim, theme-aware scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="2.5" Margin="1"
                                                        Background="{DynamicResource SubBrush}" Opacity="0.55"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter Property="Height" Value="5"/>
                                <Setter Property="Width" Value="Auto"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="5"/>
                                <Setter Property="Height" Value="Auto"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
